diff --git a/tests/tui_gateway/test_answer_versions.py b/tests/tui_gateway/test_answer_versions.py
new file mode 100644
index 0000000000..c5ff30b3e9
--- /dev/null
+++ b/tests/tui_gateway/test_answer_versions.py
@@ -0,0 +1,275 @@
+"""Durable answer-version groups shared by every gateway client."""
+
+from __future__ import annotations
+
+import threading
+import types
+
+import pytest
+
+import hermes_state_answer_versions
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+def _conversation(db: SessionDB, session_id: str, *answers: str) -> list[int]:
+    db.create_session(session_id, source="tui")
+    messages = []
+    for index, answer in enumerate(answers):
+        messages.extend((
+            {"role": "user", "content": f"question {index}"},
+            {"role": "assistant", "content": answer},
+        ))
+    db.append_messages_batch(session_id, messages)
+    return [
+        message["_row_id"]
+        for message in db.get_messages_as_conversation(session_id, include_row_ids=True)
+        if message["role"] == "assistant"
+    ]
+
+
+def test_answer_version_group_reuses_logical_slot_and_resolves_current_rows(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        source_answer = _conversation(db, "source", "source answer")[0]
+        first_copy = _conversation(db, "first-copy", "source answer")[0]
+        db.record_answer_version_branch("source", source_answer, "first-copy", answer_user_ordinal=0)
+
+        # Regeneration replaces the copied assistant row. The relationship stays on the
+        # logical user-turn slot and the read returns the replacement's current row id.
+        db.replace_messages("first-copy", [
+            {"role": "user", "content": "question 0"},
+            {"role": "assistant", "content": "regenerated answer"},
+        ])
+        regenerated_answer = db.latest_message_row_id("first-copy", role="assistant")
+        second_copy = _conversation(db, "second-copy", "regenerated answer")[0]
+        db.record_answer_version_branch(
+            "first-copy", regenerated_answer, "second-copy", answer_user_ordinal=0)
+
+        result = db.get_answer_versions("first-copy", regenerated_answer)
+        assert result == {
+            "source": {"session_id": "source", "answer_row_id": source_answer},
+            "versions": [
+                {"session_id": "source", "answer_row_id": source_answer, "position": 0},
+                {"session_id": "first-copy", "answer_row_id": regenerated_answer, "position": 1},
+                {"session_id": "second-copy", "answer_row_id": second_copy, "position": 2},
+            ],
+        }
+    finally:
+        db.close()
+
+
+def test_answer_versions_exclude_member_whose_prompt_changed_at_same_ordinal(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        source_answer = _conversation(db, "source", "source answer")[0]
+        copy_answer = _conversation(db, "copy", "source answer")[0]
+        db.record_answer_version_branch("source", source_answer, "copy", answer_user_ordinal=0)
+
+        db.replace_messages("copy", [
+            {"role": "user", "content": "edited question"},
+            {"role": "assistant", "content": "answer to edited question"},
+        ])
+        edited_answer = db.latest_message_row_id("copy", role="assistant")
+
+        assert db.get_answer_versions("source", source_answer)["versions"] == [
+            {"session_id": "source", "answer_row_id": source_answer, "position": 0},
+        ]
+        assert db.get_answer_versions("copy", edited_answer) == {
+            "source": {"session_id": "copy", "answer_row_id": edited_answer},
+            "versions": [
+                {"session_id": "copy", "answer_row_id": edited_answer, "position": 0},
+            ],
+        }
+        assert db.get_answer_versions("copy", copy_answer) is None
+    finally:
+        db.close()
+
+
+def test_ungrouped_answer_uses_indexed_row_fast_path(tmp_path, monkeypatch):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        answer = _conversation(db, "ungrouped", "standalone answer")[0]
+        monkeypatch.setattr(
+            hermes_state_answer_versions,
+            "_current_answer_slots",
+            lambda *_args: pytest.fail("ungrouped read scanned the transcript"),
+        )
+
+        assert db.get_answer_versions("ungrouped", answer) == {
+            "source": {"session_id": "ungrouped", "answer_row_id": answer},
+            "versions": [
+                {"session_id": "ungrouped", "answer_row_id": answer, "position": 0},
+            ],
+        }
+        assert db.get_answer_versions("ungrouped", answer - 1) is None
+        assert db.get_answer_versions("ungrouped", answer + 1000) is None
+    finally:
+        db.close()
+
+
+def test_branch_from_stale_source_membership_creates_group_for_edited_prompt(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        old_source_answer = _conversation(db, "source", "old source answer")[0]
+        old_copy_answer = _conversation(db, "old-copy", "old source answer")[0]
+        db.record_answer_version_branch(
+            "source", old_source_answer, "old-copy", answer_user_ordinal=0)
+
+        db.replace_messages("source", [
+            {"role": "user", "content": "edited question"},
+            {"role": "assistant", "content": "new source answer"},
+        ])
+        new_source_answer = db.latest_message_row_id("source", role="assistant")
+        new_copy = _conversation(db, "new-copy", "new source answer")[0]
+
+        with pytest.raises(ValueError, match="source answer row is not current"):
+            db.record_answer_version_branch(
+                "source", old_source_answer, "new-copy", answer_user_ordinal=0)
+        db.replace_messages("new-copy", [
+            {"role": "user", "content": "edited question"},
+            {"role": "assistant", "content": "new source answer"},
+        ])
+        new_copy = db.latest_message_row_id("new-copy", role="assistant")
+        db.record_answer_version_branch(
+            "source", new_source_answer, "new-copy", answer_user_ordinal=0)
+
+        assert db.get_answer_versions("source", new_source_answer) == {
+            "source": {"session_id": "source", "answer_row_id": new_source_answer},
+            "versions": [
+                {"session_id": "source", "answer_row_id": new_source_answer, "position": 0},
+                {"session_id": "new-copy", "answer_row_id": new_copy, "position": 1},
+            ],
+        }
+        assert db.get_answer_versions("old-copy", old_copy_answer) == {
+            "source": None,
+            "versions": [
+                {"session_id": "old-copy", "answer_row_id": old_copy_answer, "position": 1},
+            ],
+        }
+    finally:
+        db.close()
+
+
+def test_answer_versions_omit_deleted_and_unanswered_members_without_grouping_generic_children(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        source_answer = _conversation(db, "source", "source answer")[0]
+        deleted_answer = _conversation(db, "deleted-copy", "source answer")[0]
+        stale_answer = _conversation(db, "stale-copy", "source answer")[0]
+        db.record_answer_version_branch("source", source_answer, "deleted-copy", answer_user_ordinal=0)
+        db.record_answer_version_branch("source", source_answer, "stale-copy", answer_user_ordinal=0)
+
+        db.delete_session("deleted-copy")
+        db.replace_messages("stale-copy", [{"role": "user", "content": "question 0"}])
+        assert db.get_answer_versions("source", source_answer) == {
+            "source": {"session_id": "source", "answer_row_id": source_answer},
+            "versions": [{"session_id": "source", "answer_row_id": source_answer, "position": 0}],
+        }
+
+        # Generic parent_session_id is used by compression and subagents too. It must
+        # never create a carousel relationship without the explicit branch metadata.
+        generic_answer = _conversation(db, "generic-child", "unrelated answer")[0]
+        assert db.get_answer_versions("generic-child", generic_answer) == {
+            "source": {"session_id": "generic-child", "answer_row_id": generic_answer},
+            "versions": [{"session_id": "generic-child", "answer_row_id": generic_answer, "position": 0}],
+        }
+        assert db.get_answer_versions("stale-copy", stale_answer) is None
+    finally:
+        db.close()
+
+
+def test_branch_relationship_requires_current_assistant_at_exact_boundary():
+    history = [
+        {"role": "user", "content": "first", "_row_id": 10},
+        {"role": "assistant", "content": "first answer", "_row_id": 11},
+        {"role": "user", "content": "second", "_row_id": 12},
+        {"role": "assistant", "content": "second answer", "_row_id": 13},
+    ]
+    relationship = {"kind": "answer_version", "source_answer_row_id": 11}
+
+    assert server._answer_version_branch_target(relationship, history, count=2) == (11, 0)
+    assert server._answer_version_branch_target(relationship, history, count=4) is None
+    assert server._answer_version_branch_target(
+        {"kind": "answer_version", "source_answer_row_id": 10}, history, count=1) is None
+    assert server._answer_version_branch_target(
+        {"kind": "compression", "source_answer_row_id": 11}, history, count=2) is None
+
+
+def test_session_branch_records_answer_relationship_only_after_boundary_validation(tmp_path, monkeypatch):
+    db = SessionDB(tmp_path / "state.db")
+    source_answer = _conversation(db, "source", "source answer")[0]
+    history = db.get_messages_as_conversation("source", include_row_ids=True)
+    server._sessions["runtime"] = {
+        "session_key": "source", "history": history, "history_lock": threading.Lock(),
+        "running": False, "cols": 80, "profile_home": None, "source": "tui",
+        "agent": types.SimpleNamespace(model="test-model"), "created_at": 1.0,
+        "last_active": 1.0, "cwd": str(tmp_path),
+    }
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    monkeypatch.setattr(server, "_new_session_key", lambda: "answer-copy")
+    monkeypatch.setattr(server, "_claim_active_session_slot", lambda *args, **kwargs: (None, None))
+    monkeypatch.setattr(server, "_resolve_model", lambda: "test-model")
+    monkeypatch.setattr(server, "_session_cwd", lambda _session: str(tmp_path))
+    monkeypatch.setattr(server, "_make_agent", lambda *args, **kwargs: types.SimpleNamespace())
+    monkeypatch.setattr(server, "_init_session", lambda *args, **kwargs: None)
+    try:
+        rejected = server.handle_request({
+            "id": "bad", "method": "session.branch",
+            "params": {"session_id": "runtime", "count": 1, "relationship": {
+                "kind": "answer_version", "source_answer_row_id": source_answer,
+            }},
+        })
+        assert rejected["error"]["code"] == 4024
+        assert db.get_session("answer-copy") is None
+
+        accepted = server.handle_request({
+            "id": "good", "method": "session.branch",
+            "params": {"session_id": "runtime", "count": 2, "relationship": {
+                "kind": "answer_version", "source_answer_row_id": source_answer,
+            }},
+        })
+        assert "result" in accepted, accepted
+        child_answer = db.latest_message_row_id("answer-copy", role="assistant")
+        assert db.get_answer_versions("answer-copy", child_answer)["versions"] == [
+            {"session_id": "source", "answer_row_id": source_answer, "position": 0},
+            {"session_id": "answer-copy", "answer_row_id": child_answer, "position": 1},
+        ]
+    finally:
+        server._sessions.pop("runtime", None)
+        db.close()
+
+
+def test_answer_versions_rpc_reads_only_the_requested_profile_store(tmp_path, monkeypatch):
+    launch_db = SessionDB(tmp_path / "launch.db")
+    profile_home = tmp_path / "profiles" / "writer"
+    profile_home.mkdir(parents=True)
+    profile_db = SessionDB(profile_home / "state.db")
+    try:
+        launch_answer = _conversation(launch_db, "same", "launch answer")[0]
+        profile_answer = _conversation(profile_db, "same", "profile answer")[0]
+        copy_answer = _conversation(profile_db, "profile-copy", "profile answer")[0]
+        profile_db.record_answer_version_branch("same", profile_answer, "profile-copy", answer_user_ordinal=0)
+
+        monkeypatch.setattr(server, "_get_db", lambda: launch_db)
+        monkeypatch.setattr(server, "_profile_home", lambda name: profile_home if name == "writer" else None)
+
+        profiled = server.handle_request({
+            "id": "profiled", "method": "session.answer_versions",
+            "params": {"profile": "writer", "session_id": "same", "answer_row_id": profile_answer},
+        })
+        assert profiled["result"]["versions"] == [
