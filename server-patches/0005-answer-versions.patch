+"""Durable answer-version relationships for SessionDB."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import uuid
+
+
+def _prompt_fingerprint(content) -> str:
+    """Stable identity for the canonical text/media payload of one user request."""
+    encoded = json.dumps(content, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(encoded.encode("utf-8", errors="surrogatepass")).hexdigest()
+
+
+def _current_answer_slots(conn, session_id: str, decode_content) -> dict[int, tuple[int, str]]:
+    """Current assistant row and prompt fingerprint keyed by user-turn ordinal."""
+    from agent.context_compressor import user_originated_turn_view
+
+    rows = conn.execute(
+        "SELECT id, role, content, display_kind FROM messages "
+        "WHERE session_id = ? AND active = 1 ORDER BY id",
+        (session_id,),
+    ).fetchall()
+    ordinal = -1
+    prompt_fingerprint = None
+    answers: dict[int, tuple[int, str]] = {}
+    for row in rows:
+        content = decode_content(row["content"])
+        message = {"role": row["role"], "content": content}
+        if row["display_kind"]:
+            message["display_kind"] = row["display_kind"]
+        live_user = user_originated_turn_view(message) if row["role"] == "user" else None
+        if live_user is not None:
+            ordinal += 1
+            prompt_fingerprint = _prompt_fingerprint(live_user.get("content"))
+        elif (row["role"] == "assistant" and ordinal >= 0
+              and prompt_fingerprint is not None
+              and isinstance(content, str) and content.strip()):
+            answers[ordinal] = (int(row["id"]), prompt_fingerprint)
+    return answers
+
+
+class SessionAnswerVersionsMixin:
+    """Persist explicit answer branches without overloading generic session lineage."""
+
+    def record_answer_version_branch(
+        self,
+        source_session_id: str,
+        source_answer_row_id: int,
+        child_session_id: str,
+        *,
+        answer_user_ordinal: int,
+    ) -> str:
+        """Attach a durable branch child to a logical answer slot and return its group id."""
+        if (not source_session_id or not child_session_id or source_session_id == child_session_id
+                or isinstance(source_answer_row_id, bool) or not isinstance(source_answer_row_id, int)
+                or isinstance(answer_user_ordinal, bool) or not isinstance(answer_user_ordinal, int)
+                or answer_user_ordinal < 0):
+            raise ValueError("invalid answer-version relationship")
+        new_group_id = uuid.uuid4().hex
+
+        def _do(conn):
+            source_slots = _current_answer_slots(conn, source_session_id, self._decode_content)
+            source_slot = source_slots.get(answer_user_ordinal)
+            if source_slot is None or source_slot[0] != source_answer_row_id:
+                raise ValueError("source answer row is not current at the requested logical slot")
+            child_slot = _current_answer_slots(conn, child_session_id, self._decode_content).get(
+                answer_user_ordinal
+            )
+            if child_slot is None or child_slot[1] != source_slot[1]:
+                raise ValueError("branch child does not contain the requested logical answer slot")
+            prompt_fingerprint = source_slot[1]
+
+            source_member = conn.execute(
+                "SELECT group_id, source_session_id, source_answer_row_id, prompt_fingerprint "
+                "FROM answer_version_members WHERE session_id = ? AND answer_user_ordinal = ?",
+                (source_session_id, answer_user_ordinal),
+            ).fetchone()
+            if source_member is not None and source_member["prompt_fingerprint"] != prompt_fingerprint:
+                conn.execute(
+                    "DELETE FROM answer_version_members "
+                    "WHERE session_id = ? AND answer_user_ordinal = ?",
+                    (source_session_id, answer_user_ordinal),
+                )
+                source_member = None
+            if source_member is None:
+                group_id = new_group_id
+                origin_session_id = source_session_id
+                origin_answer_row_id = source_answer_row_id
+                conn.execute(
+                    "INSERT INTO answer_version_members "
+                    "(group_id, session_id, answer_user_ordinal, prompt_fingerprint, position, "
+                    " source_session_id, source_answer_row_id) VALUES (?, ?, ?, ?, 0, ?, ?)",
+                    (group_id, source_session_id, answer_user_ordinal,
+                     prompt_fingerprint, origin_session_id, origin_answer_row_id),
+                )
+            else:
+                group_id = source_member["group_id"]
+                origin_session_id = source_member["source_session_id"]
+                origin_answer_row_id = int(source_member["source_answer_row_id"])
+
+            existing_child = conn.execute(
+                "SELECT group_id, prompt_fingerprint FROM answer_version_members "
+                "WHERE session_id = ? AND answer_user_ordinal = ?",
+                (child_session_id, answer_user_ordinal),
+            ).fetchone()
+            if existing_child is not None and existing_child["prompt_fingerprint"] != prompt_fingerprint:
+                conn.execute(
+                    "DELETE FROM answer_version_members "
+                    "WHERE session_id = ? AND answer_user_ordinal = ?",
+                    (child_session_id, answer_user_ordinal),
+                )
+                existing_child = None
+            if existing_child is not None:
+                if existing_child["group_id"] != group_id:
+                    raise ValueError("branch child already belongs to another answer-version group")
+                return group_id
+            position = conn.execute(
+                "SELECT COALESCE(MAX(position), -1) + 1 FROM answer_version_members WHERE group_id = ?",
+                (group_id,),
+            ).fetchone()[0]
+            conn.execute(
+                "INSERT INTO answer_version_members "
+                "(group_id, session_id, answer_user_ordinal, prompt_fingerprint, position, "
+                " source_session_id, source_answer_row_id) VALUES (?, ?, ?, ?, ?, ?, ?)",
+                (group_id, child_session_id, answer_user_ordinal, prompt_fingerprint, position,
+                 origin_session_id, origin_answer_row_id),
+            )
+            return group_id
+
+        return self._execute_write(_do)
+
+    def get_answer_versions(self, session_id: str, answer_row_id: int):
+        """Return the explicit group for a current assistant row, or a singleton when ungrouped."""
+        if (not session_id or isinstance(answer_row_id, bool)
+                or not isinstance(answer_row_id, int)):
+            return None
+        with self._read_ctx() as conn:
+            has_membership = conn.execute(
+                "SELECT 1 FROM answer_version_members WHERE session_id = ? LIMIT 1",
+                (session_id,),
+            ).fetchone()
+            if has_membership is None:
+                row = conn.execute(
+                    "SELECT role, content FROM messages "
+                    "WHERE session_id = ? AND id = ? AND active = 1",
+                    (session_id, answer_row_id),
+                ).fetchone()
+                content = self._decode_content(row["content"]) if row is not None else None
+                if (row is None or row["role"] != "assistant"
+                        or not isinstance(content, str) or not content.strip()):
+                    return None
+                version = {"session_id": session_id, "answer_row_id": answer_row_id,
+                           "position": 0}
+                return {"source": {"session_id": session_id,
+                                   "answer_row_id": answer_row_id},
+                        "versions": [version]}
+
+            slots = _current_answer_slots(conn, session_id, self._decode_content)
+            ordinal = next((slot for slot, value in slots.items() if value[0] == answer_row_id), None)
+            if ordinal is None:
+                return None
+            prompt_fingerprint = slots[ordinal][1]
+            member = conn.execute(
+                "SELECT group_id, source_session_id, source_answer_row_id, prompt_fingerprint "
+                "FROM answer_version_members WHERE session_id = ? AND answer_user_ordinal = ?",
+                (session_id, ordinal),
+            ).fetchone()
+            if member is None or member["prompt_fingerprint"] != prompt_fingerprint:
+                version = {"session_id": session_id, "answer_row_id": answer_row_id, "position": 0}
+                return {"source": {"session_id": session_id, "answer_row_id": answer_row_id},
+                        "versions": [version]}
+
+            rows = conn.execute(
+                "SELECT av.session_id, av.answer_user_ordinal, av.prompt_fingerprint, av.position "
+                "FROM answer_version_members av JOIN sessions s ON s.id = av.session_id "
+                "WHERE av.group_id = ? ORDER BY av.position, av.session_id",
+                (member["group_id"],),
+            ).fetchall()
+            versions = []
+            for row in rows:
+                current = _current_answer_slots(conn, row["session_id"], self._decode_content).get(
+                    int(row["answer_user_ordinal"])
+                )
+                if current is not None and current[1] == row["prompt_fingerprint"]:
+                    versions.append({"session_id": row["session_id"], "answer_row_id": current[0],
+                                     "position": int(row["position"])})
+            source = next((
+                {"session_id": version["session_id"], "answer_row_id": version["answer_row_id"]}
+                for version in versions if version["session_id"] == member["source_session_id"]
+            ), None)
+            return {"source": source, "versions": versions}
