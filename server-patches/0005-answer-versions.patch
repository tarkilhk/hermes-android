+-- Explicit answer branches only. ``sessions.parent_session_id`` also represents
+-- compression and subagent lineage, so it cannot identify answer alternatives.
+CREATE TABLE IF NOT EXISTS answer_version_members (
+    group_id TEXT NOT NULL,
+    session_id TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
+    answer_user_ordinal INTEGER NOT NULL CHECK (answer_user_ordinal >= 0),
+    prompt_fingerprint TEXT NOT NULL,
+    position INTEGER NOT NULL CHECK (position >= 0),
+    source_session_id TEXT NOT NULL,
+    source_answer_row_id INTEGER NOT NULL,
+    PRIMARY KEY (group_id, session_id),
+    UNIQUE (session_id, answer_user_ordinal),
+    UNIQUE (group_id, position)
+);
+
