+def _answer_version_branch_target(relationship, history: list, count):
+    """Validated ``(assistant row id, user ordinal)`` for an exact answer boundary."""
+    if (not isinstance(relationship, dict) or relationship.get("kind") != "answer_version"
+            or isinstance(count, bool) or not isinstance(count, int) or count <= 0):
