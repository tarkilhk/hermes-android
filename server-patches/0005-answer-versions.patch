+                    current_answers[ordinal] = (int(raw), index)
+    target = next((
+        (answer_row_id, answer_ordinal)
+        for answer_ordinal, (answer_row_id, index) in current_answers.items()
+        if answer_row_id == row_id and index + 1 == count
+    ), None)
+    return target
