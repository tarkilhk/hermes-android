+_SENSITIVE_RECOVERY_FIELDS = {
+    "sudo.request": (),
+    "secret.request": ("prompt", "env_var"),
+    "vault.unlock.request": ("backend", "display_name"),
+    "vault.save_login.request": ("origin", "site"),
+    "vault.code.request": ("site", "hint"),
