+def _pending_sensitive_request_payload(sid: str) -> dict | None:
+    """Current in-process sensitive prompt as display metadata only.
+
+    Compute-host sensitive prompts are intentionally absent: the parent mirrors and proxies only
+    clarify requests today, so it cannot claim an authoritative outstanding sensitive request.
+    """
+    now = time.monotonic()
+    with _prompt_lock:
+        for rid, (owner_sid, event) in list(_pending.items()):
+            if owner_sid != sid or event.is_set():
+                continue
+            deadline = _pending_prompt_deadlines.get(rid)
+            if deadline is not None and deadline <= now:
+                continue
+            request_type, source = _pending_prompt_payloads.get(rid, ("", {}))
+            fields = _SENSITIVE_RECOVERY_FIELDS.get(request_type)
+            if fields is None or not isinstance(source, dict):
+                continue
+            payload = {"request_id": rid}
+            for field in fields:
+                value = source.get(field)
+                if isinstance(value, str) and value.strip():
+                    payload[field] = value.strip()[:512]
+            return {"type": request_type, "payload": payload}
+    return None
+
