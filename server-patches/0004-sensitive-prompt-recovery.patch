@@ -0,0 +1,123 @@
+from contextlib import nullcontext
+import threading
+import time
+import types
+
+import pytest
+
+from tui_gateway import server
+
+
+def _put(rid, sid, request_type, payload, *, deadline=None, signaled=False):
+    event = threading.Event()
+    if signaled:
+        event.set()
+    with server._prompt_lock:
+        server._pending[rid] = (sid, event)
+        server._pending_prompt_payloads[rid] = (request_type, {**payload, "request_id": rid})
+        server._pending_prompt_deadlines[rid] = deadline
+
+
+def _clear():
+    with server._prompt_lock:
+        server._pending.clear()
+        server._pending_prompt_payloads.clear()
+        server._pending_prompt_deadlines.clear()
+
+
+@pytest.mark.parametrize(("request_type", "source", "expected"), [
+    ("sudo.request", {}, {}),
+    ("secret.request", {"prompt": "Enter API key", "env_var": "SERVICE_KEY"},
+     {"prompt": "Enter API key", "env_var": "SERVICE_KEY"}),
+    ("vault.unlock.request", {"backend": "onepassword", "display_name": "Work vault"},
+     {"backend": "onepassword", "display_name": "Work vault"}),
+    ("vault.save_login.request", {"origin": "https://example.test", "site": "example.test"},
+     {"origin": "https://example.test", "site": "example.test"}),
+    ("vault.code.request", {"site": "example.test", "hint": "Authenticator code"},
+     {"site": "example.test", "hint": "Authenticator code"}),
+])
+def test_sensitive_snapshot_copies_only_display_allowlist(request_type, source, expected):
+    _put("rid", "owner", request_type, {
+        **source, "password": "never-copy", "value": "never-copy", "answer": "never-copy",
+        "metadata": {"token": "never-copy"}, "command": "never-copy"})
+    try:
+        assert server._pending_sensitive_request_payload("owner") == {
+            "type": request_type, "payload": {"request_id": "rid", **expected}}
+    finally:
+        _clear()
+
+
+def test_sensitive_snapshot_requires_owner_unanswered_and_unexpired_request():
+    _put("owned", "owner", "sudo.request", {})
+    _put("answered", "owner", "secret.request", {"prompt": "Prompt"}, signaled=True)
+    _put("expired", "owner", "vault.code.request", {"site": "site"}, deadline=time.monotonic() - 1)
+    try:
+        assert server._pending_sensitive_request_payload("other") is None
+        assert server._pending_sensitive_request_payload("owner") == {
+            "type": "sudo.request", "payload": {"request_id": "owned"}}
+        with server._prompt_lock:
+            server._pending["owned"][1].set()
+        assert server._pending_sensitive_request_payload("owner") is None
+    finally:
+        _clear()
+
+
+def test_session_info_and_live_resume_include_sensitive_snapshot(monkeypatch):
+    session = {
+        "agent": types.SimpleNamespace(), "cols": 80, "created_at": 1.0, "history": [],
+        "history_lock": threading.Lock(), "running": True, "session_key": "stored-session",
+    }
+    server._sessions["runtime"] = session
+    _put("rid", "runtime", "vault.unlock.request", {
+        "backend": "onepassword", "display_name": "Work vault", "password": "never-copy"})
+    monkeypatch.setattr(server, "_session_db", lambda _session: nullcontext(None))
+    monkeypatch.setattr(server, "_pending_approval_request_payload", lambda _key: None)
+    monkeypatch.setattr(server, "_pending_clarify_request_payload", lambda _sid: None)
+    monkeypatch.setattr(server, "_attach_todo_state", lambda payload, _session: payload)
+    monkeypatch.setattr(server, "_display_session_cwd", lambda _session: "")
+    monkeypatch.setattr(server, "_project_info_for_cwd", lambda _cwd: None)
+    monkeypatch.setattr(server.git_probe, "branch", lambda _cwd: "")
+    monkeypatch.setattr(server, "_session_live_title", lambda _session, _key: "")
+    monkeypatch.setattr(server, "_session_usage_snapshot", lambda _session: {})
+    monkeypatch.setattr(server, "_effective_terminal_backend", lambda: "local")
+    try:
+        info = server._session_info(session["agent"], session)
+        resumed = server._live_session_payload("runtime", session, omit_messages=True)
+    finally:
+        server._sessions.pop("runtime", None)
+        _clear()
+    expected = {"type": "vault.unlock.request", "payload": {
+        "request_id": "rid", "backend": "onepassword", "display_name": "Work vault"}}
+    assert info["pending_sensitive"] == expected
+    assert resumed["pending_sensitive"] == expected
+    assert set(info["pending_sensitive"]["payload"]) == {
+        "request_id", "backend", "display_name"}
+
+
+def test_session_info_event_always_includes_authoritative_null(monkeypatch):
+    frames = []
+    monkeypatch.setattr(server, "write_json", lambda frame: frames.append(frame))
+
+    server._emit("session.info", "missing", {"lazy": True})
+
+    payload = frames[0]["params"]["payload"]
+    assert payload["lazy"] is True
+    assert payload["pending_sensitive"] is None
+
+
+def test_block_removes_deadline_and_snapshot_after_timeout(monkeypatch):
+    monkeypatch.setattr(server, "_emit", lambda *_args, **_kwargs: None)
+    assert server._block("sudo.request", "runtime", {}, timeout=0) == ""
+    assert server._pending_sensitive_request_payload("runtime") is None
+    assert not server._pending_prompt_deadlines
+
+
+def test_cold_resume_explicitly_returns_null_pending_sensitive(monkeypatch):
+    ctx = types.SimpleNamespace(
+        rid="rpc", target="stored", omit_messages=False,
+        messages=lambda _display: [],
+    )
+    monkeypatch.setattr(server, "_attach_todo_state", lambda payload, _record: payload)
+    response = server._resume_response(
+        ctx, "runtime", {"created_at": 1.0}, info={}, messages=[])
+    assert response["result"]["pending_sensitive"] is None
