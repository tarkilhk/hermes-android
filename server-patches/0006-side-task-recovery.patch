 # ── side agents (background / btw / preview.restart) ────────────────────────
 
+_SIDE_TASK_LIMIT = 32
+_SIDE_TASK_PROMPT_LIMIT = 4096
+_SIDE_TASK_RESULT_LIMIT = 65536
+_SIDE_TASK_RUNNING_COUNT_LIMIT = 999
+_side_tasks_lock = threading.Lock()
+
+
+def _bounded_side_task_text(value, limit: int) -> tuple[str, bool]:
+    text = str(value or "")
+    return text[:limit], len(text) > limit
+
+
+def _prune_side_tasks(tasks: list[dict]) -> None:
+    while len(tasks) > _SIDE_TASK_LIMIT:
+        completed = next(
+            (index for index, task in enumerate(tasks) if task.get("status") != "running"), None)
+        if completed is None:
+            return
+        tasks.pop(completed)
+
+
+def _side_task_start(session: dict, task_id: str, kind: str, prompt: str) -> None:
+    bounded_prompt, prompt_truncated = _bounded_side_task_text(prompt, _SIDE_TASK_PROMPT_LIMIT)
+    with _side_tasks_lock:
+        tasks = session.setdefault("_side_tasks", [])
+        tasks.append({
+            "task_id": task_id, "kind": kind, "prompt": bounded_prompt,
+            "prompt_truncated": prompt_truncated,
+            "status": "running", "result": None, "result_truncated": False})
+        _prune_side_tasks(tasks)
+
+
+def _side_task_finish(session: dict, task_id: str, status: str, result: str) -> None:
+    bounded_result, truncated = _bounded_side_task_text(result, _SIDE_TASK_RESULT_LIMIT)
+    with _side_tasks_lock:
+        tasks = session.get("_side_tasks") or []
+        task = next((item for item in tasks if item.get("task_id") == task_id), None)
+        if task is not None:
+            task.update(status=status, result=bounded_result, result_truncated=truncated)
+        _prune_side_tasks(tasks)
+
+
+def _side_task_snapshot(session: dict | None) -> dict:
+    with _side_tasks_lock:
+        tasks = [dict(task) for task in ((session or {}).get("_side_tasks") or [])]
+    return {"retention": "live_session", "tasks": tasks}
+
+
+def _side_task_running_count(session: dict | None) -> int:
+    with _side_tasks_lock:
+        return min(_SIDE_TASK_RUNNING_COUNT_LIMIT, sum(
+            task.get("status") == "running"
+            for task in ((session or {}).get("_side_tasks") or [])))
+
+
+def _side_tasks_running(session: dict | None) -> bool:
+    return _side_task_running_count(session) > 0
+
