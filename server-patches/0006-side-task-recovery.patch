@@ -0,0 +1,180 @@
+import threading
+
+from tui_gateway import server
+
+
+def _thread_stubs(monkeypatch):
+    monkeypatch.setattr(server, "_set_session_context", lambda *_args, **_kwargs: ())
+    monkeypatch.setattr(server, "_clear_session_context", lambda _tokens: None)
+
+
+def test_running_and_completed_task_snapshot_precedes_completion_event(monkeypatch):
+    _thread_stubs(monkeypatch)
+    started = threading.Event()
+    release = threading.Event()
+    completed = threading.Event()
+    session = {"_side_tasks": []}
+    emitted = []
+
+    def body():
+        started.set()
+        assert release.wait(2)
+        return "finished result"
+
+    def emit(event, sid, payload):
+        emitted.append((event, sid, payload, server._side_task_snapshot(session)))
+        completed.set()
+
+    monkeypatch.setattr(server, "_emit", emit)
+    response = server._spawn_side_agent(
+        "rpc", session, "bg_123", "owner", "background.complete", body,
+        cwd=".", kind="background", prompt="inspect logs")
+
+    assert response["result"] == {"task_id": "bg_123"}
+    assert started.wait(2)
+    assert server._side_task_snapshot(session) == {
+        "retention": "live_session",
+        "tasks": [{
+            "task_id": "bg_123", "kind": "background", "prompt": "inspect logs",
+            "prompt_truncated": False,
+            "status": "running", "result": None, "result_truncated": False,
+        }],
+    }
+
+    release.set()
+    assert completed.wait(2)
+    terminal = emitted[0][3]["tasks"][0]
+    assert terminal["status"] == "completed"
+    assert terminal["result"] == "finished result"
+    assert emitted[0][:3] == (
+        "background.complete", "owner",
+        {"task_id": "bg_123", "text": "finished result"})
+
+
+def test_failed_task_snapshot_is_terminal_before_error_event(monkeypatch):
+    _thread_stubs(monkeypatch)
+    completed = threading.Event()
+    session = {}
+    emitted = []
+
+    def emit(event, sid, payload):
+        emitted.append((event, sid, payload, server._side_task_snapshot(session)))
+        completed.set()
+
+    monkeypatch.setattr(server, "_emit", emit)
+    server._spawn_side_agent(
+        "rpc", session, "btw_123", "owner", "btw.complete",
+        lambda: (_ for _ in ()).throw(RuntimeError("failed safely")),
+        cwd=".", extra={"question": "why?"}, kind="btw", prompt="why?")
+
+    assert completed.wait(2)
+    task = emitted[0][3]["tasks"][0]
+    assert task["status"] == "error"
+    assert task["result"] == "error: failed safely"
+    assert emitted[0][2] == {
+        "task_id": "btw_123", "question": "why?", "text": "error: failed safely"}
+
+
+def test_task_snapshot_is_session_owned_bounded_and_reports_truncation():
+    owner = {}
+    other = {}
+    for index in range(server._SIDE_TASK_LIMIT):
+        task_id = f"bg_{index}"
+        server._side_task_start(owner, task_id, "background", f"prompt {index}")
+        server._side_task_finish(owner, task_id, "completed", "result")
+    server._side_task_start(owner, "btw_running", "btw", "p" * 5000)
+    server._side_task_start(owner, "bg_latest", "background", "latest")
+    server._side_task_finish(owner, "bg_latest", "completed", "r" * 70000)
+
+    snapshot = server._side_task_snapshot(owner)
+    ids = [task["task_id"] for task in snapshot["tasks"]]
+    assert len(snapshot["tasks"]) == server._SIDE_TASK_LIMIT
+    assert "btw_running" in ids
+    assert "bg_latest" in ids
+    assert "bg_0" not in ids
+    running = next(task for task in snapshot["tasks"] if task["task_id"] == "btw_running")
+    latest = next(task for task in snapshot["tasks"] if task["task_id"] == "bg_latest")
+    assert len(running["prompt"]) == server._SIDE_TASK_PROMPT_LIMIT
+    assert running["prompt_truncated"] is True
+    assert len(latest["result"]) == server._SIDE_TASK_RESULT_LIMIT
+    assert latest["result_truncated"] is True
+    assert server._side_task_snapshot(other)["tasks"] == []
+
+
+def test_session_info_and_resume_always_include_side_task_snapshot(monkeypatch):
+    session = {
+        "agent": None, "created_at": 1.0, "history": [],
+        "history_lock": threading.Lock(), "running": False, "session_key": "stored",
+    }
+    server._side_task_start(session, "bg_1", "background", "prompt")
+    frames = []
+    monkeypatch.setattr(server, "write_json", lambda frame: frames.append(frame))
+    monkeypatch.setattr(server, "_pending_sensitive_request_payload", lambda _sid: None)
+    server._sessions["owner"] = session
+    try:
+        server._emit("session.info", "owner", {"lazy": True})
+        resumed = server._live_session_payload("owner", session, omit_messages=True)
+    finally:
+        server._sessions.pop("owner", None)
+
+    expected = server._side_task_snapshot(session)
+    assert frames[0]["params"]["payload"]["side_tasks"] == expected
+    assert resumed["side_tasks"] == expected
+    assert resumed["running"] is False
+
+
+def test_cold_resume_explicitly_returns_empty_live_session_snapshot(monkeypatch):
+    ctx = type("Ctx", (), {
+        "rid": "rpc", "target": "stored", "omit_messages": False,
+        "messages": lambda self, _display: [],
+    })()
+    monkeypatch.setattr(server, "_attach_todo_state", lambda payload, _record: payload)
+
+    result = server._resume_response(
+        ctx, "runtime", {"created_at": 1.0}, info={}, messages=[])["result"]
+
+    assert result["side_tasks"] == {"retention": "live_session", "tasks": []}
+
+
+def test_running_side_task_prevents_lru_and_disconnect_reap(monkeypatch):
+    session = {
+        "_side_tasks": [{
+            "task_id": "bg_1", "kind": "background", "prompt": "prompt",
+            "prompt_truncated": False,
+            "status": "running", "result": None, "result_truncated": False,
+        }],
+        "transport": server._detached_ws_transport,
+        "running": False,
+    }
+    monkeypatch.setattr(server, "_session_pending_kind", lambda _sid: None)
+    monkeypatch.setattr(server, "_session_has_active_delegations", lambda *_args: False)
+    assert server._session_is_lru_evictable("owner", session) is False
+    monkeypatch.setattr(server, "_session_live_title", lambda *_args: "Chat")
+    monkeypatch.setattr(server, "_resolve_model", lambda: "model")
+    assert server._session_live_item("owner", session)["side_tasks_running"] == 1
+
+    timers = []
+
+    class Timer:
+        def __init__(self, _delay, callback):
+            self.callback = callback
+            self.daemon = False
+            timers.append(self)
+
+        def start(self):
+            return None
+
+        def cancel(self):
+            return None
+
+    monkeypatch.setattr(server.threading, "Timer", Timer)
+    monkeypatch.setattr(server, "_WS_ORPHAN_REAP_GRACE_S", 1.0)
+    server._sessions["owner"] = session
+    try:
+        server._schedule_ws_orphan_reap("owner")
+        timers[0].callback()
+        assert server._sessions["owner"] is session
+        assert len(timers) == 2
+    finally:
+        server._pending_ws_reaps.pop("owner", None)
+        server._sessions.pop("owner", None)
